# =============================================================================
# .deploy.env.example - Cau hinh deploy cho ci_deploy.ps1
#
# Cach dung:
#   copy .deploy.env.example .deploy.env
#   (chinh sua .deploy.env voi gia tri thuc, file nay se KHONG bi commit)
# =============================================================================

# ---------------------------------------------------
# Target mac dinh khi chay: .\ci_deploy.ps1 -Deploy
# Gia tri hop le: zip | railway | render | gcp | ssh
# ---------------------------------------------------
DEPLOY_TARGET=zip

# ---------------------------------------------------
# RAILWAY - railway.app
# 1. Cai CLI:    npm install -g @railway/cli
# 2. Dang nhap: railway login
# 3. Tao project: railway init (trong thu muc du an)
# ---------------------------------------------------
# RAILWAY_TOKEN=

# ---------------------------------------------------
# RENDER - render.com
# Lay Deploy Hook URL tai:
#   Render Dashboard > Service > Settings > Deploy Hook
# ---------------------------------------------------
# RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxxx?key=yyyyy

# ---------------------------------------------------
# GOOGLE CLOUD RUN - cloud.google.com/run
# Yeu cau: gcloud CLI da cai va da authen (gcloud auth login)
# ---------------------------------------------------
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_SERVICE_NAME=noxh-api
# GCP_REGION=asia-southeast1

# ---------------------------------------------------
# SSH / VPS
# SSH_KEY_PATH: de trong neu dung mat khau hoac SSH agent
# SSH_APP_DIR:  thu muc tren server de deploy vao
# ---------------------------------------------------
# SSH_HOST=deploy@123.45.67.89
# SSH_PORT=22
# SSH_APP_DIR=/home/deploy/noxh-app
# SSH_KEY_PATH=C:\Users\yourname\.ssh\id_rsa
