{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:mobile": "vite build --config vite.mobile.config.ts && node -e \"require('fs').renameSync('dist-mobile/index-mobile.html','dist-mobile/index.html')\"",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:watch-gen": "tsx scripts/watch-tests.ts",
    "sync:from-demo": "powershell -File scripts/sync-from-demo.ps1",
    "sync:dry-run": "powershell -File scripts/sync-from-demo.ps1 -DryRun",
    "ci": "pwsh -NonInteractive -File ci_deploy.ps1",
    "ci:e2e": "pwsh -NonInteractive -File ci_deploy.ps1 -E2E",
    "ci:coverage": "pwsh -NonInteractive -File ci_deploy.ps1 -Coverage",
    "ci:deploy": "pwsh -NonInteractive -File ci_deploy.ps1 -Deploy",
    "ci:deploy:railway": "pwsh -NonInteractive -File ci_deploy.ps1 -Deploy -Target railway",
    "ci:deploy:render": "pwsh -NonInteractive -File ci_deploy.ps1 -Deploy -Target render",
    "ci:deploy:gcp": "pwsh -NonInteractive -File ci_deploy.ps1 -Deploy -Target gcp",
    "ci:deploy:ssh": "pwsh -NonInteractive -File ci_deploy.ps1 -Deploy -Target ssh",
    "migrate:progress": "tsx scripts/migrate-progress.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react-datepicker": "^6.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "nodemailer": "^10.0.12",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "vite": "^6.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
